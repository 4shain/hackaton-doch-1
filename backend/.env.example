# development | production  (demo login is only possible in development)
APP_ENV=development
ID_LOGIN_ENABLED=true
# Real roster CSV (gitignored). See backend/app/seed.py for the columns.
ROSTER_PATH=data/roster.csv
DATABASE_URL=postgresql+psycopg://doch1:doch1@localhost:5433/doch1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIMEZONE=Asia/Jerusalem
DAILY_JOB_HOUR=8
SCHEDULER_ENABLED=true
SESSION_TTL_HOURS=12
# Nightly anomaly scan with TypeSafe Jev (disabled when the key is empty)
TYPESAFE_API_KEY=
ANOMALY_JOB_HOUR=2
ANOMALY_LOOKBACK_DAYS=20
ANOMALY_THRESHOLD=0.75
# Real SSO (OIDC) - not implemented yet, see README "Authentication"
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
